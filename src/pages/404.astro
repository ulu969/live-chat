---
import App from '../layouts/App.astro';
---

<App title="Not found · Live Chat">
  <main class="grid min-h-full place-items-center px-4 py-12">
    <div class="max-w-sm text-center">
      <p class="font-display text-5xl font-bold tracking-tight text-accent">404</p>
      <h1 class="mt-3 font-display text-2xl font-bold tracking-tight">There's nothing at this address</h1>
      <p class="mt-2 text-ink-soft">The link may be mistyped, or the page was moved.</p>
      <a
        href="/rooms/lobby"
        class="mt-6 inline-block rounded-lg bg-accent px-4 py-2.5 font-semibold text-accent-ink hover:brightness-110"
        >Go to the Lobby</a
      >
    </div>
  </main>
</App>
