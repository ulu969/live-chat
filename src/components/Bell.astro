---
/**
 * Notification bell: unread @mention count, and a dropdown of recent mentions.
 * The count is live: the page's SSE connection sends a `mention` event (see client.ts).
 */
interface Props {
  unread: number;
}
const { unread } = Astro.props;
---

<div
  class="relative"
  x-data="{ open: false }"
  x-init={`$store.bell.unread = ${unread}`}
  @keydown.escape.window="open = false"
>
  <button
    type="button"
    @click="open = !open; if (open) $store.bell.load()"
    :aria-expanded="open"
    aria-expanded="false"
    aria-controls="bell-panel"
    :aria-label="$store.bell.unread ? `Mentions, ${$store.bell.unread} unread` : 'Mentions'"
    aria-label="Mentions"
    class="relative rounded-md p-2 text-ink-soft hover:bg-hover hover:text-ink"
  >
    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
      ><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path></svg
    >
    <span
      id="bell-count"
      x-show="$store.bell.unread > 0"
      x-text="$store.bell.unread > 99 ? '99+' : $store.bell.unread"
      x-cloak
      class="absolute -top-0.5 -right-0.5 grid min-w-4.5 place-items-center rounded-full bg-signal px-1 text-[10px] leading-4.5 font-bold text-white tabular-nums"
      >{unread || ''}</span
    >
  </button>

  <div
    id="bell-panel"
    x-show="open"
    x-cloak
    x-transition.opacity.duration.100ms
    @click.outside="open = false"
    @click="if ($event.target.closest('a')) open = false"
    class="absolute right-0 z-30 mt-1 w-80 max-w-[calc(100vw-1.5rem)] overflow-hidden rounded-lg border border-line bg-panel shadow-lg"
  >
    <div class="flex items-center justify-between border-b border-line px-3 py-2">
      <p class="text-sm font-semibold">Mentions</p>
      <button
        type="button"
        @click="$store.bell.markAllRead()"
        :disabled="!$store.bell.unread"
        class="rounded px-1.5 py-0.5 text-xs font-medium text-accent hover:bg-hover disabled:text-ink-soft disabled:opacity-60"
      >
        Mark all read
      </button>
    </div>
    <ul id="bell-list" class="max-h-96 divide-y divide-line overflow-y-auto">
      <li class="px-3 py-6 text-center text-sm text-ink-soft">Loading…</li>
    </ul>
  </div>
</div>
