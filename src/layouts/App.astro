---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#eef3f2" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Onest:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Set the theme before first paint to avoid a flash.
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
        if (dark) document.querySelector('meta[name="theme-color"]').setAttribute('content', '#121c1f');
      })();
    </script>
  </head>
  <body class="text-[15px]">
    <slot />
    <div
      id="conn-banner"
      role="status"
      hidden
      class="fixed top-3 left-1/2 z-50 flex -translate-x-1/2 items-center gap-2 rounded-full bg-ink px-4 py-2 text-sm font-medium text-bg shadow-lg"
    >
      <svg class="size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"
        ><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity=".3" stroke-width="3"></circle><path
          d="M21 12a9 9 0 0 0-9-9"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"></path></svg
      >
      Reconnecting…
    </div>
    <script>
      import '../scripts/client.ts';
    </script>
  </body>
</html>
